{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "types": ["node"]
  },
  "include": ["apps/server/src/**/*.ts", "packages/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "apps/web/**/*.ts", "apps/web/**/*.tsx"]
}
